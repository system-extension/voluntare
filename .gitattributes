# Normaliza finais de linha: LF no repositório, padrão do SO na máquina de cada um
* text=auto

# Scripts do Maven Wrapper precisam manter o final de linha correto em cada SO
backend/mvnw text eol=lf
*.cmd text eol=crlf
# Arquivos usados dentro dos contêineres (Linux) ficam sempre com LF, mesmo no Windows
Dockerfile text eol=lf
*.sh text eol=lf
nginx.conf text eol=lf
